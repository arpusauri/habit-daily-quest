import React, { useState } from "react";

const QuestSection = ({
  habits,
  newHabitName,
  setNewHabitName,
  addHabit,
  completeHabit,
  deleteHabit,
  onReorderHabits,
}) => {
  const [draggedHabit, setDraggedHabit] = useState(null);
  const [dragOverIndex, setDragOverIndex] = useState(null);

  const handleDragStart = (e, habit) => {
    setDraggedHabit(habit);
    e.dataTransfer.effectAllowed = "move";
  };

  const handleDragOver = (e, index) => {
    e.preventDefault();
    e.dataTransfer.dropEffect = "move";
    setDragOverIndex(index);
  };

  const handleDragLeave = () => {
    setDragOverIndex(null);
  };

  const handleDrop = (e, targetHabit) => {
    e.preventDefault();
    setDragOverIndex(null);

    if (!draggedHabit || draggedHabit.id === targetHabit.id) {
      setDraggedHabit(null);
      return;
    }

    const draggedIndex = habits.findIndex((h) => h.id === draggedHabit.id);
    const targetIndex = habits.findIndex((h) => h.id === targetHabit.id);

    const newHabits = [...habits];
    newHabits.splice(draggedIndex, 1);
    newHabits.splice(targetIndex, 0, draggedHabit);

    if (onReorderHabits) {
      onReorderHabits(newHabits);
    }

    setDraggedHabit(null);
  };

  const handleDragEnd = () => {
    setDraggedHabit(null);
    setDragOverIndex(null);
  };

  return (
    <div className="w-full">
      {/* Section Header */}
      <div className="text-left mt-8 mb-6 border-b-2 border-black pb-3">
        <h2 className="text-2xl font-black text-black tracking-tight">
          Daily Quests
        </h2>
      </div>

      {/* Background Container - Monokrom Wireframe */}
      <div className="bg-white border-2 border-black p-6">
        {/* Form Add Quest */}
        <form onSubmit={addHabit} className="mb-6 flex gap-3 items-center">
          <input
            type="text"
            value={newHabitName}
            onChange={(e) => setNewHabitName(e.target.value)}
            placeholder="Add a new daily quest..."
            className="flex-1 min-w-0 px-4 py-2 text-sm border-2 border-black focus:outline-none bg-white"
          />
          <button
            type="submit"
            className="px-6 py-2 text-sm font-black text-white bg-black hover:bg-gray-900 active:scale-95 transition-all"
          >
            Add Quest
          </button>
        </form>

        {/* Divider */}
        <div className="border-t-2 border-black mb-5"></div>

        {/* Habits List */}
        <div className="space-y-3">
          {habits.length === 0 ? (
            <div className="p-6 text-center border-2 border-black bg-gray-50">
              <p className="text-gray-700 font-semibold">
                No quests yet. Add one to get started!
              </p>
            </div>
          ) : (
            habits.map((habit, index) => (
              <div
                key={habit.id}
                draggable
                onDragStart={(e) => handleDragStart(e, habit)}
                onDragOver={(e) => handleDragOver(e, index)}
                onDragLeave={handleDragLeave}
                onDrop={(e) => handleDrop(e, habit)}
                onDragEnd={handleDragEnd}
                className={`p-4 border-2 flex justify-between items-center transition-all cursor-move ${
                  draggedHabit?.id === habit.id
                    ? "opacity-50 bg-gray-100 border-gray-400"
                    : dragOverIndex === index
                      ? "bg-gray-100 border-black"
                      : habit.is_completed
                        ? "bg-gray-100 border-gray-300"
                        : "bg-white border-black"
                }`}
              >
                <div className="text-left flex-1">
                  <h3
                    className={`text-base font-bold ${
                      habit.is_completed
                        ? "text-gray-400 line-through"
                        : "text-black"
                    }`}
                  >
                    {habit.name}
                  </h3>
                  <p
                    className={`text-xs font-semibold mt-2 ${
                      habit.is_completed ? "text-gray-400" : "text-gray-600"
                    }`}
                  >
                    {habit.streak} Day Streak
                  </p>
                </div>

                <div className="flex gap-2 items-center ml-4 shrink-0">
                  {!habit.is_completed ? (
                    <button
                      type="button"
                      onClick={() => completeHabit(habit.id)}
                      className="px-4 py-2 font-black text-white bg-black hover:bg-gray-800 active:scale-95 transition-all text-xs border border-black"
                    >
                      COMPLETE
                    </button>
                  ) : (
                    <span className="px-4 py-2 font-black text-gray-700 bg-gray-200 border-2 border-gray-400 text-xs">
                      CLEARED
                    </span>
                  )}

                  <button
                    type="button"
                    onClick={() => deleteHabit(habit.id)}
                    className="w-8 h-8 flex items-center justify-center border-2 border-black text-black hover:bg-black hover:text-white transition-colors font-bold"
                    title="Delete Quest"
                  >
                    ×
                  </button>
                </div>
              </div>
            ))
          )}
        </div>
      </div>
    </div>
  );
};

export default QuestSection;
